# Copy this file to .env and fill in your Google Analytics 4 Measurement ID
# (looks like "G-XXXXXXXXXX") to enable analytics. Leave it blank/unset to
# disable analytics entirely (e.g. in local dev).
PUBLIC_GA_MEASUREMENT_ID=

# The site's public domain, e.g. "example.com" or "https://example.com".
# Used to give recipe JSON-LD absolute URLs. Optional, but set it for production.
PUBLIC_SITE_URL=
