# Copy this file to .env and fill in your Google Analytics 4 Measurement ID
# (looks like "G-XXXXXXXXXX") to enable analytics. Leave it blank/unset to
# disable analytics entirely (e.g. in local dev).
PUBLIC_GA_MEASUREMENT_ID=

# Overrides the site's public domain (defaults to "mountainkitchen.org").
# Used for absolute URLs in recipe JSON-LD, sitemap.xml and robots.txt.
PUBLIC_SITE_URL=

# Newsletter signup form. Leave the URL blank to hide the form everywhere.
# PROVIDER is one of: mailerlite (default), kit, buttondown — see src/lib/newsletter.js.
# For MailerLite, the URL is the form's action from its embed code, e.g.
# https://assets.mailerlite.com/jsonp/<account id>/forms/<form id>/subscribe
PUBLIC_NEWSLETTER_PROVIDER=mailerlite
PUBLIC_NEWSLETTER_FORM_URL=
